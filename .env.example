# MongoDB Local (Docker)
MONGO_LOCAL_URI=mongodb://localhost:27017/
MONGO_LOCAL_DB=bigdata_local

# MongoDB Atlas (Cloud)
# Podmień dane poniżej na własne po utworzeniu klastra M0 w MongoDB Atlas
MONGO_ATLAS_URI=mongodb+srv://<username>:<password>@<cluster-address>.mongodb.net/?retryWrites=true&w=majority
MONGO_ATLAS_DB=bigdata_atlas
